# Copy to .env.local for local development. Never commit .env.local.

# Public app URL (used in metadata, absolute links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base URL. Required — see src/lib/env.ts.
NEXT_PUBLIC_API_BASE_URL=https://raiquid-api-production.up.railway.app

# Clerk publishable key (safe to expose to the browser). Required — see
# src/lib/env.ts. Get it from the Clerk dashboard for this project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key. Server-only — no NEXT_PUBLIC_ prefix, never sent to the
# browser. Read directly by @clerk/nextjs (clerkMiddleware()/auth()), not by
# src/lib/env.ts, so it never enters the client bundle. Required for the
# app's own Next.js server process to talk to Clerk's Backend API — unlike
# the raiquid-api backend's own R2/Resend keys, this one genuinely belongs
# here, not just on that other server.
CLERK_SECRET_KEY=
