# Node 22 (see .nvmrc) is the standard and what CI runs on. The
# package.json "engines" field is a soft signal, not a gate:
# engine-strict=false keeps `npm install` from erroring for anyone whose
# global npm config sets it true. Next.js 16.3 itself only needs Node
# >=20.9, so teammates on 20.9+ can install and run — they'll just see a
# one-time EBADENGINE warning nudging them to upgrade.
engine-strict=false
